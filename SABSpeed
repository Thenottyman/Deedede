-- SPEED BOOST
local speedConnection = nil

function applySpeed()
    if not player.Character then return end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    if speedConnection then
        speedConnection:Disconnect()
        speedConnection = nil
    end
    
    if speedBoostEnabled then
        hum.WalkSpeed = boostedWalkSpeed
        
        speedConnection = RunService.Heartbeat:Connect(function()
            if speedBoostEnabled and hum and hum.Parent then
                if hum.WalkSpeed ~= boostedWalkSpeed then
                    hum.WalkSpeed = boostedWalkSpeed
                end
            end
        end)
    else
        hum.WalkSpeed = 16
    end
end

player.CharacterAdded:Connect(function(char)
    wait(0.5)
    applySpeed()
end)

-- Position lock
local function lockPositionOnLagStop()
    if savedPosition and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        hrp.CFrame = savedPosition
        hrp.Anchored = true
        
        task.wait(0.5)
        
        if hrp and hrp.Parent then
            hrp.Anchored = false
        end
        
        print("NOTTY HUB: Position locked, lagback prevented")
    end
end

-- Button / Keybinds
lagBtn.MouseButton1Click:Connect(function()
    lagModeEnabled = not lagModeEnabled
    updateLagUI()
    
    if not lagModeEnabled then
        lockPositionOnLagStop()
    end
end)

speedBtn.MouseButton1Click:Connect(function()
    speedBoostEnabled = not speedBoostEnabled
    updateSpeedUI()
    applySpeed()
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.E then
        lagModeEnabled = not lagModeEnabled
        updateLagUI()
        
        if not lagModeEnabled then
            lockPositionOnLagStop()
        end
    elseif input.KeyCode == Enum.KeyCode.F then
        speedBoostEnabled = not speedBoostEnabled
        updateSpeedUI()
        applySpeed()
    elseif input.KeyCode == Enum.KeyCode.U then
        frame.Visible = not frame.Visible
    end
end)

-- Initial setup
if player.Character then 
