    if obj:IsA("RemoteEvent") and not obj.Name:lower():match("ping") and not obj.Name:lower():match("friend") then
        table.insert(allRemotes, obj)
    end
end

-- Auto-select best remote and check if supported
for _, remote in ipairs(allRemotes) do
    local nameLower = remote.Name:lower()
    for _, kw in ipairs(targetKeywords) do
        if nameLower:find(kw:lower()) then
            remoteEventTarget = remote
            isRemoteSupported = true
            print("NOTTY HUB: Selected target - " .. remote.Name)
            break
        end
    end
    if remoteEventTarget then break end
end

if not remoteEventTarget and #allRemotes > 0 then
    remoteEventTarget = allRemotes[1]
