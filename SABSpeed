-- Update slider visuals
local function updateSlider()
    local minSpeed = 16
    local maxSpeed = 120
    local percentage = (boostedWalkSpeed - minSpeed) / (maxSpeed - minSpeed)
    
    speedSliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    speedSliderKnob.Position = UDim2.new(percentage, -10, 0, 0)
    speedLabel.Text = "Speed: " .. math.floor(boostedWalkSpeed)
end

-- Update payload slider
local function updatePayloadSlider()
    local minPayload = 1000
    local maxPayload = 10000
    local percentage = (dataPayloadSize - minPayload) / (maxPayload - minPayload)
    
    payloadSliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    payloadSliderKnob.Position = UDim2.new(percentage, -10, 0, 0)
    payloadLabel.Text = "Payload: " .. math.floor(dataPayloadSize)
    
    -- Update dataPayload string
    dataPayload = string.rep("z", dataPayloadSize)
end

-- Speed Slider dragging logic (works on mobile & PC)
local draggingSpeedSlider = false

speedSliderBG.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSpeedSlider = true
    end
end)

speedSliderBG.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingSpeedSlider = false
    end
end)

speedSliderBG.InputChanged:Connect(function(input)
    if draggingSpeedSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local sliderSize = speedSliderBG.AbsoluteSize.X
        local relativeX = input.Position.X - speedSliderBG.AbsolutePosition.X
        local percentage = math.clamp(relativeX / sliderSize, 0, 1)
        
        local minSpeed = 16
        local maxSpeed = 120
        boostedWalkSpeed = minSpeed + (percentage * (maxSpeed - minSpeed))
        
        updateSlider()
        
        -- Apply speed immediately if enabled
        if speedBoostEnabled then
            applySpeed()
        end
    end
end)

