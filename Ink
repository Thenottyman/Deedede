-- ================= DRAG FIX =================
local dragging, dragStart, startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- ================= ANIMATIONS =================
local function tween(obj, time, props)
    TweenService:Create(
        obj,
        TweenInfo.new(time, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        props
    ):Play()
end

-- Hover animation
btn.MouseEnter:Connect(function()
    tween(btn, 0.2, {BackgroundColor3 = Color3.fromRGB(60,60,60)})
end)

btn.MouseLeave:Connect(function()
    tween(btn, 0.2, {BackgroundColor3 = Color3.fromRGB(40,40,40)})
end)

-- ================= DESYNC LOGIC =================
local used = false
local savedCFrame

local function runNoRespawnDesync()
    local char = plr.Character
    if not char then return false end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return false end

    savedCFrame = root.CFrame

    pcall(function()
        setfflag("NextGenReplicatorEnabledWrite4","false")
    end)

    task.wait(0.55)

    pcall(function()
        setfflag("NextGenReplicatorEnabledWrite4","true")
    end)

    task.wait(0.1)
    root.CFrame = savedCFrame
    return true
end

plr.CharacterAdded:Connect(function(char)
    if not used or not savedCFrame then return end
    task.spawn(function()
        local root = char:WaitForChild("HumanoidRootPart",5)
        if root then
            root.CFrame = savedCFrame
        end
    end)
end)

-- ================= BUTTON ACTION =================
btn.MouseButton1Click:Connect(function()
    if used then return end
    used = true

    status.Text = "Status: Executing..."
    status.TextColor3 = Color3.fromRGB(255,200,0)
    tween(btn, 0.15, {Size = UDim2.new(0,180,0,34)})

    if runNoRespawnDesync() then
        status.Text = "Status: Desync Active"
        status.TextColor3 = Color3.fromRGB(255,90,90)
        btn.Text = "DESYNCED"
        tween(btn, 0.25, {
            BackgroundColor3 = Color3.fromRGB(120,35,35)
        })
    else
        status.Text = "Status: Failed"
        status.TextColor3 = Color3.fromRGB(255,80,80)
        btn.Text = "FAILED"
        tween(btn, 0.25, {
            BackgroundColor3 = Color3.fromRGB(80,30,30)
        })
    end
end)
