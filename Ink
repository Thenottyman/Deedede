-- ================= DRAG (ORIGINAL – UNCHANGED) =================
local dragging, dragStart, startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- ================= HARD CLIENT INVIS =================
local invisConn
local invisActive = false
local selfVisible = false

local function makeInvisible(char)
    for _,v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = 1
            v.LocalTransparencyModifier = 1
            v.CastShadow = false
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 1
        end
    end
end

local function makeVisible(char)
    for _,v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Transparency = 0
            v.LocalTransparencyModifier = 0
            v.CastShadow = true
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v.Transparency = 0
        end
    end
end

local function enableInvis()
    if invisConn then invisConn:Disconnect() end
    invisConn = RunService.RenderStepped:Connect(function()
        if selfVisible then return end
        if plr.Character then
            makeInvisible(plr.Character)
        end
    end)
end

plr.CharacterAdded:Connect(function(char)
    if invisActive then
        char:WaitForChild("HumanoidRootPart",5)
        task.wait(0.1)
        enableInvis()
    end
end)

