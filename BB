-- STATUS HELPER
local function setStatus(text, color)
    statusLabel.Text = "Status: "..text
    TweenService:Create(statusLabel, TweenInfo.new(0.2), {
        TextColor3 = color
    }):Play()
end

-- =========================
-- DESYNC LOGIC (UNCHANGED)
-- =========================

local processing = false
local savedCFrame = nil

local function forceRespawn()
    local char = plr.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
    else
        char:BreakJoints()
    end
end

local function doNoRespawnDesync()
    if processing then return end
    processing = true
    setStatus("Processing", Color3.fromRGB(255,200,90))

    local char = plr.Character
    if not char then
        setStatus("No Character", Color3.fromRGB(255,90,90))
        processing = false
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then
        setStatus("Humanoid/Root Missing", Color3.fromRGB(255,90,90))
        processing = false
        return
    end
    if hum.Health <= 0 then
        setStatus("Dead", Color3.fromRGB(255,90,90))
        processing = false
        return
    end

    savedCFrame = root.CFrame

    pcall(function()
        setfflag("NextGenReplicatorEnabledWrite4","false")
    end)

    setStatus("Desyncing", Color3.fromRGB(255,120,120))
    TweenService:Create(bar, TweenInfo.new(0.55), {
        Size = UDim2.new(1,0,1,0)
    }):Play()

    task.wait(0.543)

    pcall(function()
        setfflag("NextGenReplicatorEnabledWrite4","true")
    end)

    task.wait(0.1)
    root.CFrame = savedCFrame

    setStatus("Desync Complete", Color3.fromRGB(90,255,120))
    TweenService:Create(bar, TweenInfo.new(0.25), {
        Size = UDim2.new(0,0,1,0)
    }):Play()

    -- FORCE RESPAWN (NOT RESET)
    task.wait(0.15)
    forceRespawn()

    processing = false
end

button.MouseButton1Click:Connect(doNoRespawnDesync)
