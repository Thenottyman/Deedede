-- Update Display
local function updateDisplay()
    if lagModeEnabled then
        lagButton.Text = "Stop Crash (Press E)"
        lagButton.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    else
        lagButton.Text = "Start Crash (Press E)"
        lagButton.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    end
end

-- Lag Button Click
lagButton.MouseButton1Click:Connect(function()
    lagModeEnabled = not lagModeEnabled
    updateDisplay()
end)

-- Keybinds
UserInputService.InputBegan:Connect(function(inputObject, isGameProcessed)
    if not isGameProcessed and inputObject.KeyCode == Enum.KeyCode.E then
        lagModeEnabled = not lagModeEnabled
        updateDisplay()
    elseif not isGameProcessed and inputObject.KeyCode == Enum.KeyCode.U then
        mainFrame.Visible = not mainFrame.Visible
    end
end)

-- Original lag logic
RunService.Heartbeat:Connect(function()
    if lagModeEnabled and remoteEventTarget then
        for iteration = 1, 1 do
            remoteEventTarget:FireServer(uniqueIdentifier, dataPayload)
        end
    end
end)

-- Draggable Main Frame (Mobile & PC)
local dragging = false
local dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

