local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local lagModeEnabled = false
local uniqueIdentifier = "v15g2119-134z-bx1c-a143-415a31g1l029"
local dataPayload = string.rep("z", 30000)
local remoteEventTarget = nil
local allRemotes = {}

-- Keywords to search for
local targetKeywords = {"RobloxChatSystemMessage", "AFK", "FisherMan"}

-- Find all remotes
for index, gameObject in pairs(game:GetDescendants()) do
    if gameObject:IsA("RemoteEvent") and gameObject.Name ~= "friendmain" and gameObject.Name ~= "ping" then
        table.insert(allRemotes, gameObject)
    end
end

-- Auto-select first remote containing target keywords
for _, remote in pairs(allRemotes) do
    local remoteName = remote.Name:lower()
    for _, keyword in pairs(targetKeywords) do
        if remoteName:find(keyword:lower()) then
            remoteEventTarget = remote
            print("✅ Auto-selected: " .. remote.Name)
            break
        end
    end
    if remoteEventTarget then break end
end

-- Fallback if no keyword match found
if not remoteEventTarget and #allRemotes > 0 then
    print("⚠️ No keyword match found, using first available remote")
    remoteEventTarget = allRemotes[1]
end

-- Create GUI
